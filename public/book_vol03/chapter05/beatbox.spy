'''beatbox, Version 1.0

It\'s a beat box. Play with it, and you\'ll find out what it does.

This project is part of the book "Creative Python Programming with Strype, Volume 3".
Authors: Michael Kölling and Neil C.C. Brown'''
#(=> Section:Imports
from strype.graphics import * 
from strype.sound import * 
#(=> Section:Definitions
#The 16 percussion sounds
drums  = [load_sound("data:audio/wav;base64,"),load_sound("data:audio/wav;base64,"),load_sound("data:audio/wav;base64,"),load_sound("data:audio/wav;base64,"),load_sound("data:audio/wav;base64,"),load_sound("data:audio/wav;base64,"),load_sound("data:audio/wav;base64,"),load_sound("data:audio/wav;base64,"),load_sound("data:audio/wav;base64,"),load_sound("data:audio/wav;base64,"),load_sound("data:audio/wav;base64,"),load_sound("data:audio/wav;base64,"),load_sound("data:audio/wav;base64,"),load_sound("data:audio/wav;base64,"),load_sound("data:audio/wav;base64,"),load_sound("data:audio/wav;base64,")] 
#Playback speed. Increase this to play faster.
SPEED  = 6 
#Other constants for the program
WHITE  = load_image("data:image/png;base64,") 
BLACK  = load_image("data:image/png;base64,") 
PLAY  = load_image("data:image/png;base64,") 
STOP  = load_image("data:image/png;base64,") 
NUM_BEATS  = 16 
GRID_LEFT  = -280 
GRID_TOP  = 260 
GRID_SPACING  = 35 
def make_buttons ( ) :
    '''Make all the buttons: the drum test buttons on the left, and the control buttons on the right.'''
    x  = -360 
    y  = GRID_TOP 
    for drum  in drums  :
        button  = Actor(load_image("data:image/png;base64,"),x,y,("drum-button",drum)) 
        y  = y - GRID_SPACING 
    quit_button  = Actor(load_image("data:image/png;base64,"),340,-260,("control","quit")) 
    global play_button 
    play_button  = Actor(PLAY,340,-210,("control","play")) 
    global on_light 
    on_light  = Actor(load_image("data:image/png;base64,"),340,260) 
def make_beats ( ) :
    '''Make the beat grid.'''
    #'beats' is the whole grid: it is a list of 16 beats
    global beats 
    beats  = [] 
    x  = GRID_LEFT 
    for beat_no  in range(NUM_BEATS)  :
        #A 'beat' is a single column of beat buttons, which play at the same time. Each beat has a button for each drum sound.
        beat  = [] 
        y  = GRID_TOP 
        for drum  in drums  :
            #A 'beat_button' is a single square button in the grid that can be switched on or off.
            beat_button  = Actor(WHITE,x,y,("beat-button",drum)) 
            beat_button.is_on  = False 
            beat.append(beat_button) 
            y  = y - GRID_SPACING 
        beats.append(beat) 
        x  = x + GRID_SPACING 
def setup ( ) :
    '''Create the whole layout: background and all the buttons.'''
    set_background("/images/backgrounds/rivets.jpg") 
    make_buttons() 
    make_beats() 
def make_demo ( ) :
    '''Make one demo rhythm. Do not call this if you want to start with an empty grid.'''
    beat_button_press(beats[0][5]) 
    beat_button_press(beats[8][5]) 
    beat_button_press(beats[2][7]) 
    beat_button_press(beats[6][7]) 
    beat_button_press(beats[7][7]) 
    beat_button_press(beats[10][7]) 
    beat_button_press(beats[11][7]) 
    beat_button_press(beats[0][15]) 
    beat_button_press(beats[4][15]) 
    beat_button_press(beats[8][15]) 
    beat_button_press(beats[12][15]) 
def get_progress_bar ( ) :
    '''Create a progress bar to show where we are while playing.'''
    progress_img  = Image(32,580) 
    progress_img.set_fill("#e9913a74") 
    progress_img.fill() 
    progress_bar  = Actor(progress_img,GRID_LEFT,0,("progress",None)) 
    return progress_bar 
def play_one_beat (beat ) :
    '''Play one beat (one column of sounds). \'beat\' is the column (the list of beat_buttons).'''
    for beat_button  in beat  :
        if beat_button.is_on  :
            sound  = beat_button.get_tag()[1] 
            sound.play() 
def play ( ) :
    '''Start playing our grid.'''
    play_button.set_image(STOP) 
    playing  = True 
    progress_bar  = get_progress_bar() 
    while playing  :
        for current_beat  in range(NUM_BEATS)  :
            pace(SPEED) 
            play_one_beat(beats[current_beat]) 
            progress_bar.set_location(GRID_LEFT + current_beat * GRID_SPACING,None) 
            clicked  = get_clicked_actor() 
            if clicked  :
                match clicked.get_tag()[0]  :
                    case "beat-button"  :
                        beat_button_press(clicked) 
                    case "control"  :
                        playing  = False 
                        play_button.set_image(PLAY) 
    progress_bar.remove() 
def quit ( ) :
    '''Quit the program (switch the box off).'''
    on_light.set_image(load_image("data:image/png;base64,")) 
    stop() 
def drum_button_press (sound ) :
    '''One of the drum buttons (the round ones on the left) was pressed. \'sound\' is the sound of the button that was pressed.'''
    sound.play() 
def beat_button_press (beat_button ) :
    '''One of the beat buttons (the squares) was pressed. \'beat_button\' is the button that was pressed.'''
    if beat_button.is_on  :
        beat_button.is_on  = False 
        beat_button.set_image(WHITE) 
    else :
        beat_button.is_on  = True 
        beat_button.set_image(BLACK) 
def control_button_press (button_label ) :
    '''One of the control buttons was pressed. \'button_label\' is the label as defined in the tag when the button was created.'''
    match button_label  :
        case "play"  :
            play() 
        case "quit"  :
            quit() 
def main_loop ( ) :
    '''This is the main loop: listen for mouse clicks and react to them.'''
    exit  = False 
    while not exit  :
        clicked  = get_clicked_actor() 
        if clicked  :
            button_type,param  = clicked.get_tag() 
            match button_type  :
                case "control"  :
                    control_button_press(param) 
                case "drum-button"  :
                    drum_button_press(param) 
                case "beat-button"  :
                    beat_button_press(clicked) 
#(=> Section:Main
setup() 
make_demo() 
main_loop() 
#(=> Section:End
