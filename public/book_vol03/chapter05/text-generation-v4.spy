'''text-generation, Version 0.4

In this version, we create n-grams for an arbitrary n to improve the quality of text.

This project is part of the book "Creative Python Programming with Strype".
Authors: Michael Kölling and Neil C.C. Brown'''
#(=> Section:Imports
import random 
#(=> Section:Definitions
#(=> FrameState:FoldToHeader;Frozen
def read_file (filename ) :
    '''Reads the full content of the file and returns it as a string'''
    with open(filename,encoding="utf-8")  as f  :
        return f.read() 
def make_ngrams (text,n ) :
    '''Take a text as a parameter and return a list of the n-grams in the text. The parameter \'n\' specifies the length of the n-grams.'''
    words  = text.split() 
    word_lists  = [] 
    for i  in range(n)  :
        word_lists.append(words[i:]) 
    
    ngrams  = zip(___strype_blank * word_lists) 
    return list(ngrams) 
def generate_next_word (prev_words,ngrams ) :
    '''Given some previous words and a list of n-grams, return a next word by randomly selecting one of the n-grams that matches the previous words.
    \'prev_word\' is a tuple of words. \'ngrams\' is a list of tuples. The length of prev_words must be one less than the length of the ngrams.'''
    following  = [] 
    for ngram  in ngrams  :
        if ngram[:-1] == prev_words  :
            following.append(ngram[-1]) 
    if len(following) == 0  :
        #if we don't find a match with all prev_words, take a match of only the last word
        for ngram  in ngrams  :
            if ngram[-2] == prev_words[-1]  :
                following.append(ngram[-1]) 
    return random.choice(following) 
#(=> Section:Main
text  = "" 
text  = text + read_file("/books/sherlock-holmes.txt") 
text  = text + read_file("/books/fairy-tales.txt") 
text  = text + read_file("/books/pride-and-prejudice.txt") 

ngrams  = make_ngrams(text,4) 

#If our n-grams are length 4, the prev_words must be length 3 (always one less)
prev_words  = ("There","was","a") 
print(___strype_blank * prev_words,end=" ") 
for n  in range(80)  :
    next_word  = generate_next_word(prev_words,ngrams) 
    print(next_word,end=" ") 
    prev_words  = prev_words[1:] + (next_word,___strype_blank) 
#(=> Section:End
