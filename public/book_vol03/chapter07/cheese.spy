'''Cheese, Version 1.0

In this game, steer the cheese across the screen, shoot the meatballs with your ketchup gun, and get rid of the meatballs before they fly into you.

Author: Michael Kölling'''
#(=> Section:Imports
from strype.graphics import * 
from strype.sound import * 
from random import randint 
import math 
#(=> Section:Definitions
#(=> FrameState:FoldToHeader
class Vector  :
    '''A 2D vector. The vector can be read and manipulated in Cartesian coordinates (as an x,y-offset pair) or in polar coordinates (as an angle and a length).'''
    #(=> FrameState:FoldToHeader
    def __init__ (self,angle=0.0,length=0,dx=0,dy=0 ) :
        '''Create the Vector. If the angle is not None, then the angle and length are used to initialise, otherwise the dx/dy coordinates are used.'''
        if angle != None  :
            self.angle,self.length  = angle,length 
            self.update_cartesian() 
        else :
            self.dx,self.dy  = dx,dy 
            self.update_polar() 
    #(=> FrameState:FoldToHeader
    def get_angle (self, ) :
        return self.angle 
    #(=> FrameState:FoldToHeader
    def get_length (self, ) :
        return self.length 
    #(=> FrameState:FoldToHeader
    def get_x (self, ) :
        return self.dx 
    #(=> FrameState:FoldToHeader
    def get_y (self, ) :
        return self.dy 
    #(=> FrameState:FoldToHeader
    def add (self,other ) :
        self.dx  = self.dx + other.dx 
        self.dy  = self.dy + other.dy 
        self.update_polar() 
    #(=> FrameState:FoldToHeader
    def update_polar (self, ) :
        self.angle  = math.degrees(math.atan2(self.dy,self.dx)) 
        self.length  = math.hypot(self.dx,self.dy) 
    #(=> FrameState:FoldToHeader
    def update_cartesian (self, ) :
        self.dx  = self.length * math.cos(math.radians(self.angle)) 
        self.dy  = self.length * math.sin(math.radians(self.angle)) 
#(=> FrameState:FoldToHeader
class FreeMover(Actor)  :
    '''A superclass for actor types with a specific kind of movement: they hold a velocity vector to determine direction and speed of movement (independent of the current rotation), and they wrap around the world edges when reaching the edge.'''
    def __init__ (self,img,x,y,tag,velocity=None ) :
        '''Create a FreeMover with a given velocity.'''
        super().__init__(img,x,y,tag) 
        if velocity  :
            self.velocity  = velocity 
        else :
            self.velocity  = Vector() 
        self.set_rotation(velocity.get_angle()) 
    def drift (self, ) :
        '''Move the actor forward at its current velocity. If it reaches the edge of the world, wrap arround to the opposite edge.'''
        x  = self.get_x() + self.velocity.get_x() 
        y  = self.get_y() + self.velocity.get_y() 
        if x < -399  :
            x  = 400 
        elif x > 400  :
            x  = -399 
        if y < -299  :
            y  = 300 
        elif y > 300  :
            y  = -299 
        self.set_location(x,y) 
    #(=> FrameState:FoldToDocumentation
    def add_to_velocity (self,force ) :
        '''Modify our velocity by adding a velocity vector'''
        self.velocity.add(force) 
    #(=> FrameState:FoldToDocumentation
    def get_velocity_copy (self, ) :
        '''Return a copy of this mover\'s velocity vector.'''
        return Vector(self.velocity.get_angle(),self.velocity.get_length()) 
#(=> FrameState:FoldToHeader
class Meatball(FreeMover)  :
    '''A meatball, free floating.'''
    meatball_img  = [load_image("data:image/png;base64,"),load_image("data:image/png;base64,"),load_image("data:image/png;base64,"),load_image("data:image/png;base64,")] 
    def __init__ (self,x,y,size=4,direction=None,speed=4 ) :
        '''Create the meatball. If direction or speed are not specified, they will be given a starting value.'''
        self.size  = size 
        if direction == None  :
            direction  = randint(0,359) 
        self.ketchup_level  = 4 - size 
        img_scale  = 0.25 * size 
        img  = self.meatball_img[self.ketchup_level].clone(img_scale) 
        super().__init__(img,x,y,"meatball",Vector(direction,speed)) 
    def act (self, ) :
        '''Do what a meatball does - drift across the screen.'''
        self.drift() 
    def hit (self, ) :
        '''The meatball was hit.'''
        self.ketchup_level  = self.ketchup_level + 1 
        if self.ketchup_level == 4  :
            self.breakup() 
        else :
            img_scale  = 0.25 * self.size 
            self.set_image(self.meatball_img[self.ketchup_level].clone(img_scale)) 
    def breakup (self, ) :
        '''The meatball was hit so much that it breaks up. If it is still big enough, it creates two smaller meatballs.'''
        if self.size <= 1  :
            self.remove() 
        else :
            angle  = self.velocity.get_angle() + randint(0,45) 
            length  = self.velocity.get_length() * 1.2 
            ast1  = Meatball(self.get_x(),self.get_y(),int(self.size / 2),angle + 60,length) 
            ast2  = Meatball(self.get_x(),self.get_y(),int(self.size / 2),angle - 60,length) 
            self.remove() 
#(=> FrameState:FoldToHeader
class Ketchup(FreeMover)  :
    '''A blob of ketchup. It might hit a meatball.'''
    ketchup_img  = load_image("data:image/png;base64,") 
    def __init__ (self,x,y,velocity,rotation ) :
        '''Create the blob with a given velocity'''
        super().__init__(self.ketchup_img,x,y,"ketchup",velocity) 
        self.set_rotation(rotation) 
        self.add_to_velocity(Vector(rotation,19.0)) 
        self.life  = 30 
    def act (self, ) :
        '''Fly. After some fixed time, disappear. Check whether we hit a meatball.'''
        if self.life <= 0  :
            self.remove() 
        else :
            self.life  = self.life - 1 
            self.drift() 
            self.check_meatball_hit() 
    def check_meatball_hit (self, ) :
        meatball  = self.get_touching("meatball") 
        if meatball  :
            self.remove() 
            meatball.hit() 
#(=> FrameState:FoldToHeader
class Cheese(FreeMover)  :
    '''The Cheese wedge is the player vehicle. It floats across the screen and reacts to keypresses.'''
    cheese_img  = load_image("data:image/png;base64,") 
    cheese_with_flame_img  = load_image("data:image/png;base64,") 
    KETCHUP_DELAY_TIME  = 5 
    def __init__ (self,x,y ) :
        #Create the cheese initially slowly drifting
        super().__init__(self.cheese_img,x,y,"cheese",Vector(13.0,0.7)) 
        self.ketchup_delay  = self.KETCHUP_DELAY_TIME 
    def act (self, ) :
        '''Do what the rockets does: drift through space, react to keys, and blow up when hitting an asteroid.'''
        self.drift() 
        self.check_keys() 
        self.check_collision() 
        self.ketchup_delay  = self.ketchup_delay + 1 
    def check_keys (self, ) :
        '''Check for keypresses and react to them.'''
        self.ignite(key_pressed("up")) 
        if key_pressed("left")  :
            self.turn(9) 
        if key_pressed("right")  :
            self.turn(-9) 
        if key_pressed("space")  :
            self.shoot() 
    def check_collision (self, ) :
        '''Check whether we have run into an asteroid. Game over if we have.'''
        if self.is_touching("meatball")  :
            load_sound("data:audio/wav;base64,").play() 
            load_sound("data:audio/x-wav;base64,").play() 
            self.remove() 
            Actor(load_image("data:image/png;base64,")) 
            #(=> Disabled:stop() 
    def ignite (self,booster_on ) :
        '''Should the rocket be ignited?'''
        if booster_on  :
            self.set_image(self.cheese_with_flame_img) 
            self.add_to_velocity(Vector(self.get_rotation(),0.5)) 
        else :
            self.set_image(self.cheese_img) 
    def shoot (self, ) :
        '''Shoot a blob of ketchup'''
        if self.ketchup_delay > self.KETCHUP_DELAY_TIME  :
            load_sound("data:audio/wav;base64,").play() 
            ketchup  = Ketchup(self.get_x(),self.get_y(),self.get_velocity_copy(),self.get_rotation()) 
            ketchup.drift() 
            self.ketchup_delay  = 0 
#(=> FrameState:FoldToHeader
def setup ( ) :
    '''Set up the world. This includes creating the astronauts.'''
    NUM_MEATBALLS  = 2 
    
    set_background(load_image("data:image/png;base64,")) 
    cheese  = Cheese(0,-200) 
    for i  in range(NUM_MEATBALLS)  :
        #place asteroids only in the top half of the world, so they do not touch the rocket
        meatball  = Meatball(randint(-360,360),randint(0,260)) 
#(=> FrameState:FoldToHeader
def run_actors ( ) :
    '''Move the asteroid. The asteroid moves forward automatically. When the asteroid hits the rocket, you lose.'''
    actors  = get_actors() 
    for actor  in actors  :
        #need to check whether actor is in the world - they could just have been removed
        if actor.get_x() is not None  :
            if hasattr(actor,"act")  :
                actor.act() 
    num_meatballs  = len(get_actors("meatball")) 
    win_showing  = len(get_actors("win")) > 0 
    #make sure to do this only once (if we are not already showing "win"):
    if num_meatballs == 0 and  not win_showing  :
        load_sound("data:audio/x-wav;base64,").play() 
        Actor(load_image("data:image/png;base64,"),tag="win") 
        #(=> Disabled:stop() 
#(=> Section:Main
setup() 
while True  :
    run_actors() 
    pace(30) 
#(=> Section:End
