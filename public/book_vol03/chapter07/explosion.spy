'''Explosion, version 1.0

A short demo to shoe an explosion effect. Prass any key to set it off.

This project is part of the book "Creative Python Programming with Strype".
Author: Michael Kölling'''
#(=> Section:Imports
from strype.graphics import * 
from strype.sound import * 
from random import randint,uniform 
#(=> Section:Definitions
#GRAVITY: the acceleration downwards at each step of movement
GRAVITY  = 2 
#FORCE: the force of the explosion. change this to make it weaker or stronger
FORCE  = 20 
def place_rocks (number ) :
    '''Place a number of rocks into the world. The parameter determines how many.'''
    for r  in range(number)  :
        rock  = Actor(rock_img,randint(-380,380),randint(-280,280)) 
        rock.set_rotation(randint(0,360)) 
def explode (rock ) :
    '''Explode the rock. That is: remove it from the world, and place instead a whole lot of debris fragments in its place.'''
    place_debris(rock.get_x(),rock.get_y(),40) 
    rock.remove() 
def place_debris (x,y,num_fragments ) :
    '''Place a number of rock fragments into space at the indicated location. The parameter determines how many fragments we want. Each fragment will have a random initial direction and speed of movement.'''
    for i  in range(num_fragments)  :
        #give each fragment a different size image
        img  = debris_img.clone(uniform(0.3,1.0)) 
        deb  = Actor(img,x,y,"debris") 
        deb.set_rotation(randint(0,359)) 
        #give each fragment a random initial movement speed (dx, dy), determined by the FORCE of the explosion
        deb.dx  = randint(-FORCE,FORCE) 
        deb.dy  = randint(-FORCE,FORCE) 
def debris_fall ( ) :
    '''Make all debris fragments fall donw. This function will run until all pieces of debris in the world have fallen out of the world.'''
    debris  = get_actors("debris") 
    while len(debris) > 0  :
        for deb  in debris  :
            move_debris(deb) 
        debris  = get_actors("debris") 
        pace(30) 
def move_debris (deb ) :
    '''Move on piece of debris one small step forward.'''
    if deb.is_at_edge()  :
        deb.remove() 
    else :
        #The speed of movement is determined by the piece's own dx/dy values
        deb.set_location(deb.get_x() + deb.dx,deb.get_y() + deb.dy) 
        #At every step, change the dy speed to be more negative (downward) by a constant amount. This applies gravity.
        deb.dy  = deb.dy - GRAVITY 
#(=> Section:Main
#Set it all up
set_background("white") 
rock_img  = load_image("data:image/png;base64,") 
debris_img  = load_image("data:image/png;base64,") 
NUM_ROCKS  = 10 
place_rocks(NUM_ROCKS) 

rocks  = get_actors() 
for i  in range(NUM_ROCKS)  :
    get_key() 
    #after a key press, take a random one of the rocks and make it explode
    rock  = rocks.pop() 
    explode(rock) 
    debris_fall() 
#(=> Section:End
